---
// FRT-12: main season leaderboard route on the shared foundations.
// BaseLayout supplies the document shell, skip link, nav, and footer;
// DS6 keeps this home title unique against the subpages (which carry
// suffixes). The island renders the season table with sorting, search,
// aggregate stats, and the 8 s live data flow.
import BaseLayout from '../layouts/BaseLayout.astro';
import Leaderboard from '../components/leaderboard/Leaderboard';
import WelcomeOverlay from '../components/welcome/WelcomeOverlay';
---

<BaseLayout
  title="SPT Leaderboard"
  description="Current SPT (Single Player Tarkov) season rankings: scores, levels, K/D, survival rates, raids, and live online status, with sortable columns, search, and an 8-second live data flow."
>
  <h1 tabindex="-1">SPT Leaderboard</h1>
  <p>Current season player rankings, updated live.</p>
  <Leaderboard client:load />
  <!-- Dossier §Welcome gate: dismissible non-blocking first-visit overlay. -->
  <WelcomeOverlay client:load />
</BaseLayout>
